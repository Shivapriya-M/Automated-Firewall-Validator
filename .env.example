# Copy to .env for local server configuration. Never commit a populated .env.
PORT=5000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/firewall_validator?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
ALLOW_REGISTRATION=true

# Required only when running npm run seed.
SEED_ADMIN_USERNAME=replace_with_admin_username
SEED_ADMIN_EMAIL=replace_with_admin_email
SEED_ADMIN_PASSWORD=replace_with_a_unique_strong_password
